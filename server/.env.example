MONGO_URI=mongodb://127.0.0.1:27017/library_management
JWT_SECRET=your_jwt_secret_here
PORT=5000
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@library.com
SEED_ADMIN_PASSWORD=admin123

# Deployed frontend's URL, for CORS (leave blank to allow any origin - fine
# for local dev, e.g.:
# CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URL=

# Twilio gateway for bulk SMS / WhatsApp reminders (leave blank to disable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender (an SMS-capable Twilio number, E.164)
TWILIO_SMS_FROM=
# WhatsApp sender (Twilio WhatsApp number, E.164, no "whatsapp:" prefix)
TWILIO_WHATSAPP_FROM=
# Country code prepended to bare 10-digit numbers (India = 91)
DEFAULT_COUNTRY_CODE=91

# SMTP gateway for bulk email (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
